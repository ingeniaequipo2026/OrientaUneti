APP_NAME=OrientaUneti
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de datos PostgreSQL (Local o Render)
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orientauneti
DB_USER=postgres
DB_PASS=postgres

# En Render la variable DATABASE_URL se configura automáticamente:
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# Correo institucional receptor de atención al usuario
MAIL_TO=bienestar@uneti.edu.ve
