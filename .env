APP_NAME=OrientaUneti
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Motor de Base de Datos: 'mysql' (para XAMPP local) o 'pgsql' (para PostgreSQL / Render)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orientauneti
DB_USER=root
DB_PASS=

# Configuración si utiliza PostgreSQL local:
# DB_DRIVER=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=orientauneti
# DB_USER=postgres
# DB_PASS=postgres

# En Render la variable DATABASE_URL se configura automáticamente en producción:
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# Correo receptor de Atención al Usuario
MAIL_TO=bienestar@uneti.edu.ve
